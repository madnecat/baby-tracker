# Copy to server/.env.local (git-ignored) and fill in. Used only for running locally:
#   cd server && node --env-file=.env.local src/index.js
PORT=8099
DATA_DIR=C:/Users/you/AppData/Local/Temp/bt-local
DB_PATH=C:/Users/you/AppData/Local/Temp/bt-local/baby-tracker.db

PARENT1_USERNAME=thomas
PARENT1_PASSWORD=testpass123
PARENT1_DISPLAY_NAME=Thomas
PARENT2_USERNAME=wife
PARENT2_PASSWORD=testpass456
PARENT2_DISPLAY_NAME=Wife
# Which configured parent is Mum (1 or 2)
MOM_PARENT=2

# Outgoing email (OVH). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=http://localhost:8099
ADMIN_EMAIL=
